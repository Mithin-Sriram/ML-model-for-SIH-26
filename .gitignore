cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Large datasets
data/raw/*
data/intermediate/*
data/final/*
!data/raw/.gitkeep
!data/intermediate/.gitkeep
!data/final/.gitkeep

# Model artifacts
models/*.pkl
models/*.joblib
models/*.json

# Temporary files
*.tmp
*.log
.DS_Store
EOF